<% layout("/layouts/boilerplate") -%>
<div class="row"> 
    <div class="col-8 offset-2">
            <h3>Create a new listing</h3>
            <br/>
                <form method="POST" action="/listings">
                    <div>
                        <label for="title" class="form-label">Title</label>
                        <input name="listing[title]"  placeholder="Add a catchy title" type=" text" class="form-control">
                        <br/>
                    </div>
                    <div>
                        <label for="description" class="form-label">Description</label>
                        <textarea name="listing[description]" placeholder="enter description" type="text" class="form-control"></textarea>
                        <br/>
                    </div>
                    <div>
                        <label for="image" class="form-label">Image Link</label>
                        <input name="listing[image]" placeholder="enter image link" type="text" class="form-control">
                        <br/>
                    </div>
                    <div>
                        <label for="price" class="form-label">Price</label>
                        <input name="listing[price]" placeholder="1200" type="number" class="form-control">
                        <br/>
                    </div>
                    <div class="row">
                        <div class="col-12 col-md-4">
                            <label for="location" class="form-label">Location</label>
                            <input name="listing[location]" placeholder="Nashik, Maharashtra" type="text" class="form-control">
                            
                        </div>
                        <div class="col-12 col-md-8">
                            <label for="country" class="form-label">Country</label>
                            <input name="listing[country]" placeholder="India" type="text" class="form-control">
                            
                        </div>
                    </div>
                    <br/>
                    <button class="btn btn-dark add-btn">Add</button>
                    <br/><br/>
                </form>
    </div>
</div>